<%= render @customer %>

<div class="flex items-center gap-4">
  <%= link_to "Editar este cliente", edit_customer_path(@customer), class: "rounded-lg bg-sky-600 px-4 py-2 font-semibold text-white hover:bg-sky-500" %>
  <%= link_to "Voltar para clientes", customers_path, class: "text-sky-400 hover:text-sky-300" %>
  <%= button_to "Excluir este cliente", @customer, method: :delete, class: "cursor-pointer rounded-lg bg-red-600/80 px-4 py-2 font-semibold text-white hover:bg-red-500" %>
</div>
