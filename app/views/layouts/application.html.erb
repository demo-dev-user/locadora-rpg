<!DOCTYPE html>
<html>
  <head>
    <title>Locadora RPG</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>

  <body class="min-h-screen bg-slate-900 text-slate-100">
    <header class="bg-slate-800 border-b border-slate-700">
      <nav class="max-w-4xl mx-auto px-5 py-4 flex items-center gap-6">
        <%= link_to "Locadora RPG", root_path, class: "text-lg font-bold text-sky-400" %>
        <div class="flex gap-4 text-sm">
          <%= link_to "Clientes", customers_path, class: "text-slate-300 hover:text-sky-400" %>
          <%= link_to "Filmes", movies_path, class: "text-slate-300 hover:text-sky-400" %>
          <%= link_to "Locações", rentals_path, class: "text-slate-300 hover:text-sky-400" %>
        </div>
      </nav>
    </header>

    <main class="max-w-4xl mx-auto px-5 py-8">
      <% if notice %>
        <p class="mb-6 rounded-lg border border-emerald-500/50 bg-emerald-500/10 px-4 py-3 text-emerald-300"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="mb-6 rounded-lg border border-red-500/50 bg-red-500/10 px-4 py-3 text-red-300"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
