<%= form_with(model: movie) do |form| %>
  <% if movie.errors.any? %>
    <div class="mb-6 rounded-lg border border-red-500/50 bg-red-500/10 p-4 text-red-300">
      <h2 class="font-semibold mb-2"><%= pluralize(movie.errors.count, "erro") %> impediram o salvamento:</h2>
      <ul class="list-disc list-inside">
        <% movie.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-6">
    <%= form.label :title, "Título", class: "block mb-1 text-sm font-medium text-slate-300" %>
    <%= form.text_field :title, class: "w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:border-sky-500" %>
  </div>

  <div class="mb-6">
    <%= form.label :status, "Status", class: "block mb-1 text-sm font-medium text-slate-300" %>
    <%= form.select :status, options_for_select([["Disponível", "available"], ["Alugado", "rented"]], movie.status || "available"), {}, class: "w-full rounded-lg border border-slate-600 bg-slate-800 px-3 py-2 text-slate-100 focus:outline-none focus:border-sky-500" %>
  </div>

  <div>
    <%= form.submit movie.new_record? ? "Cadastrar filme" : "Salvar alterações", class: "rounded-lg bg-sky-600 px-4 py-2 font-semibold text-white hover:bg-sky-500 cursor-pointer" %>
  </div>
<% end %>
