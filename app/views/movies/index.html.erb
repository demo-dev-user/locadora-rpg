<h1 class="text-3xl font-bold mb-6">Filmes</h1>

<% if @movies.any? %>
  <div class="space-y-3 mb-6">
    <% @movies.each do |movie| %>
      <div class="rounded-lg border border-slate-700 bg-slate-800 p-4 flex items-center justify-between gap-4">
        <div>
          <p class="text-lg">
            <strong class="text-slate-400">Título:</strong>
            <%= movie.title %>
          </p>
          <p class="mt-2">
            <% if movie.available? %>
              <span class="inline-block rounded-full bg-emerald-500/20 border border-emerald-500 px-3 py-1 text-sm font-semibold text-emerald-300">Disponível</span>
            <% else %>
              <span class="inline-block rounded-full bg-amber-500/20 border border-amber-500 px-3 py-1 text-sm font-semibold text-amber-300">Alugado</span>
            <% end %>
          </p>
        </div>
        <%= link_to "Ver", movie, class: "text-sky-400 hover:text-sky-300 shrink-0" %>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-slate-400 mb-6">Nenhum filme cadastrado.</p>
<% end %>

<%= link_to "Novo filme", new_movie_path, class: "inline-block rounded-lg bg-sky-600 px-4 py-2 font-semibold text-white hover:bg-sky-500" %>
