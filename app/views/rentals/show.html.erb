<h1>Detalhes da Locação</h1>

<p>
  <strong>Filme:</strong>
  <%= @rental.movie.title %>
</p>

<p>
  <strong>Cliente:</strong>
  <%= @rental.customer.name %>
</p>

<p>
  <strong>Data Locação:</strong>
  <%= @rental.rented_at&.strftime('%d/%m/%Y %H:%M') %>
</p>

<p>
  <strong>Data Devolução:</strong>
  <%= @rental.returned_at&.strftime('%d/%m/%Y %H:%M') || 'Não devolvido' %>
</p>

<p>
  <strong>Status:</strong>
  <%= @rental.returned? ? 'Devolvida' : 'Alugada' %>
</p>

<%= link_to 'Voltar', rentals_path %>
